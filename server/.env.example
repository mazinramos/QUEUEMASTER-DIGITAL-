# QueueMaster Digital - copy to .env and fill. Never commit .env
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
# Required in production: long random strings (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=
TICKET_TOKEN_PEPPER=
# 32 bytes hex (64 chars) for AES-GCM phone encryption
PHONE_ENC_KEY=
DATA_DIR=./data
# none | console | (provider name)
SMS_PROVIDER=none
# Optional Firebase sync (leave empty to disable)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
