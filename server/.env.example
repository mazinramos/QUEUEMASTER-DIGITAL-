# ============================================================
# QueueMaster Digital — نسخة المثال. انسخها إلى server/.env واملأها.
# ممنوع رفع ملف .env إلى Git. لا تضع قيماً حقيقية في هذا الملف.
# ============================================================

# --- الخادم ---
# منفذ التشغيل
PORT=3000
# العنوان الذي يصل به المرضى (يدخل في رابط QR). على شبكة العيادة: http://192.168.x.x:3000
BASE_URL=http://localhost:3000
# development | production | test  (في production الأسرار أدناه إلزامية ويفشل الإقلاع بدونها)
NODE_ENV=development
# مجلد قاعدة البيانات والنسخ الاحتياطية
DATA_DIR=./data

# --- الأسرار (إلزامية في production) ---
# في التطوير تُولَّد تلقائياً مرة واحدة وتُحفظ في DATA_DIR/.dev-secrets.json (خارج Git).
# ولّد كل قيمة بالأمر:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# سر الجلسات (16 حرفاً على الأقل)
SESSION_SECRET=
# ملح تجزئة توكن التذكرة. تغييره يُبطل كل التذاكر القائمة! (16 حرفاً على الأقل)
TICKET_TOKEN_PEPPER=
# مفتاح تشفير أرقام الهواتف AES-256: 64 خانة hex بالضبط. فقدانه يعني تعذر فك الأرقام المخزنة
PHONE_ENC_KEY=

# --- الكوكي على شبكة العيادة ---
# false (الافتراضي): بدون Secure، مناسب لـ http://192.168.x.x (لا HTTPS على الشبكة المحلية)
# auto : Secure فقط عندما يصل الطلب عبر HTTPS (خلف Nginx/Caddy يمرّر X-Forwarded-Proto)
# true : Secure دائماً. فعّله فقط إذا كان الموقع كله HTTPS، وإلا لن يعمل الدخول من المتصفح
COOKIE_SECURE=false
# دقائق الخمول قبل انتهاء الجلسة
# SESSION_IDLE_MIN=30

# --- الحماية من التخمين ---
# أقصى محاولات دخول لكل IP في 15 دقيقة
# LOGIN_RATE_MAX=10
# عدد المحاولات الفاشلة قبل قفل اسم المستخدم، ومدة القفل بالدقائق (محفوظ في قاعدة البيانات)
# LOCK_AFTER_FAILS=5
# LOCK_MINUTES=15
# أقصى تذاكر يصدرها نفس الجهاز كل 10 دقائق (لحساب 2)
# TICKET_ISSUE_MAX_PER_10MIN=

# --- النسخ الاحتياطي ---
# تفعيل النسخ اليومي التلقائي (true/false)
# BACKUP_ENABLED=true
# كل كم ساعة تُؤخذ نسخة
# BACKUP_INTERVAL_HOURS=24
# عدد النسخ المحتفظ بها (الأقدم يُحذف)
# BACKUP_KEEP=7

# --- السجلات ---
# json | text
# LOG_FORMAT=text
# debug | info | warn | error
# LOG_LEVEL=info

# --- إدارة العيادات (اختياري) ---
# رمز سري (32 حرفاً على الأقل) يفتح POST /api/super/clinics لإنشاء عيادة جديدة. اتركه فارغاً لتعطيل المسار
SUPER_ADMIN_TOKEN=

# --- الرسائل النصية SMS ---
# none (معطل) | console (يطبع رقماً مقنّعاً للتجربة فقط) | http (مزود عبر HTTP)
SMS_PROVIDER=none
# عنوان مزود الرسائل (يقبل {{to}} و{{body}} داخله)
SMS_HTTP_URL=
# POST (افتراضي) | GET
SMS_HTTP_METHOD=POST
# application/json (افتراضي) | application/x-www-form-urlencoded
SMS_HTTP_CONTENT_TYPE=application/json
# ترويسات JSON مثل: {"Authorization":"Bearer XXXX"}
SMS_HTTP_HEADERS=
# قالب الجسم مثل: {"to":"{{to}}","text":"{{body}}","from":"Clinic"}
SMS_HTTP_BODY=
# تعبير نمطي يجب أن يطابق ردّ المزود ليُعدّ ناجحاً (اختياري)
SMS_HTTP_SUCCESS_REGEX=
# مسار معرّف الرسالة داخل JSON الرد مثل: data.id (اختياري)
SMS_HTTP_ID_PATH=
# مهلة الطلب بالميلي ثانية
SMS_HTTP_TIMEOUT_MS=10000

# --- مزامنة Firebase (اختياري) ---
# مسار ملف JSON لحساب الخدمة (Service Account). الملف نفسه لا يُرفع إلى Git أبداً
# بدونه تبقى المزامنة معلّقة (pending_integration) ولا تؤثر على الطابور المحلي
FIREBASE_SERVICE_ACCOUNT_PATH=
